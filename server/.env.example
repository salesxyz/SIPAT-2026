# ---------- Servidor ----------
NODE_ENV=development
PORT=3000
# URL pública do site (usada nos links dos QR Codes). Em produção: https://seu-app.onrender.com
PUBLIC_URL=http://localhost:3000

# ---------- Banco (PostgreSQL / Supabase) ----------
# Supabase: Project Settings > Database > Connection string (use o pooler, porta 6543 ou 5432)
DATABASE_URL=postgresql://postgres:SENHA@db.xxxxx.supabase.co:5432/postgres

# ---------- Autenticação do admin ----------
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
ADMIN_NAME=Administrador SIPAT
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-esta-senha

# ---------- Armazenamento das fotos ----------
# supabase (produção) | local (apenas desenvolvimento/teste)
STORAGE_DRIVER=supabase
SUPABASE_URL=https://xxxxx.supabase.co
# Chave service_role: SOMENTE no servidor, nunca no frontend
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=sipat-photos
# Só para STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage-data

# ---------- Limites ----------
MAX_UPLOAD_MB=15
MAX_FILES_PER_REQUEST=10
