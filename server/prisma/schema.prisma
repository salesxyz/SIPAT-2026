generator client {
  provider = "prisma-client"
  output   = "../src/generated"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("admin")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("users")
}

model Event {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  date        DateTime? @db.Date
  location    String?
  status      String   @default("active")
  isListed    Boolean  @default(true) @map("is_listed")
  qrCodeToken String   @unique @map("qr_code_token")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  albums      Album[]
  photos      Photo[]

  @@map("events")
}

model Album {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  photos      Photo[]

  @@index([eventId])
  @@map("albums")
}

model Photo {
  id         String   @id @default(uuid()) @db.Uuid
  albumId    String   @map("album_id") @db.Uuid
  eventId    String   @map("event_id") @db.Uuid
  fileName   String   @map("file_name")
  filePath   String   @unique @map("file_path")
  thumbPath  String?  @map("thumb_path")
  fileSize   Int      @map("file_size")
  mimeType   String   @map("mime_type")
  uploadedAt DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  album      Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploads    Upload[]

  @@index([eventId, uploadedAt(sort: Desc)])
  @@index([albumId, uploadedAt(sort: Desc)])
  @@map("photos")
}

model Upload {
  id           String   @id @default(uuid()) @db.Uuid
  photoId      String   @map("photo_id") @db.Uuid
  uploadStatus String   @default("completed") @map("upload_status")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  photo        Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@index([photoId])
  @@map("uploads")
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("settings")
}
